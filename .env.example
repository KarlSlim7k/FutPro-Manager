# ============================================================
# FutPro Manager · Variables de Entorno de Ejemplo
# ============================================================
# Duplica este archivo como .env.local para desarrollo local:
#   cp .env.example .env.local
# NUNCA subas claves secretas (service_role) ni .env.local a git.
# ============================================================

# URL del proyecto Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co

# Llave pública / anónima (segura para el navegador con RLS activo)
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-or-anon-key

# URL base pública del frontend
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Correo de contacto público y soporte
NEXT_PUBLIC_CONTACT_EMAIL=contacto@futpromanager.com

# Logto (auth social / SMS) — tenant FutPro Manager (r3qv5a)
LOGTO_ENDPOINT=https://r3qv5a.logto.app/
LOGTO_APP_ID=rcy12ljbvz0gbc556lgz7
# Secreto temporal solo dev (caduca ~1h). Genera uno durable en Logto Console para prod.
LOGTO_APP_SECRET=
LOGTO_COOKIE_SECRET=genera-uno-de-64-hex-con-openssl-rand-hex-32
